    <CalendarTrigger>
      <StartBoundary>2026-10-24T10:00:00-06:00</StartBoundary>
      <ScheduleByWeek>
        <WeeksInterval>1</WeeksInterval>
        <DaysOfWeek>
          <Sunday />
        </DaysOfWeek>
      </ScheduleByWeek>
    </CalendarTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>powershell.exe</Command>
      <Arguments>-NoProfile -NonInteractive -ExecutionPolicy Bypass -WindowStyle Hidden -File "D:\sgsi_laboratorio\scripts\tarea_recuperacion_programada.ps1" -Trigger programada</Arguments>
      <WorkingDirectory>D:\sgsi_laboratorio</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
