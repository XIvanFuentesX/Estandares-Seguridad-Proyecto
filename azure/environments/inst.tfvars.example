# ESCENARIO 3 — INSTITUCIONAL DE REFERENCIA (ambiente inst)
# SÓLO REFERENCIA para dimensionar costos y controles de una implantación real 24x7.
# No aplicar en el laboratorio académico.

environment   = "inst"
location      = "eastus2"
prefix        = "uvcg-sgsi"
unique_suffix = "ins01"

enable_policies       = true
enable_budget         = true
manage_defender_plans = true
budget_amount         = 3000
budget_start_date     = "2026-11-01T00:00:00Z"
budget_contact_emails = ["seguridad-ti@uvcg.example", "finanzas@uvcg.example"]

defender_plans = {
  VirtualMachines = "Standard"
  StorageAccounts = "Standard"
  KeyVaults       = "Standard"
  Arm             = "Standard"
}

enable_monitoring        = true
log_retention_days       = 90
log_daily_quota_gb       = -1
enable_sentinel          = true
enable_alerts            = true
enable_key_vault         = true
enable_storage           = true
storage_replication_type = "GRS"
enable_private_endpoints = true

enable_backup       = true
backup_storage_mode = "GeoRedundant"
backup_immutability = "Unlocked"

enable_vpn_gateway    = true
vpn_gateway_sku       = "VpnGw1AZ"
onprem_address_spaces = ["192.168.50.0/24"]
# onprem_gateway_address = "<IP pública del campus>"

enable_firewall   = true
firewall_sku_tier = "Standard"
enable_bastion    = true
bastion_sku       = "Basic"

enable_app_gateway = true
# Referencia NO secreta al certificado (el certificado vive sólo en Key Vault).
app_gateway_certificate_secret_id = "https://kv-uvcgsgsi-inst-ins01.vault.azure.net/secrets/cert-uvcg"
app_gateway_backend_addresses     = ["10.21.20.10"]

alert_email_receivers = {
  soc = "soc@uvcg.example"
}
security_contact_email = "soc@uvcg.example"
principals             = {}
