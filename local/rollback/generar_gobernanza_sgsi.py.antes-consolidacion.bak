scale = """## Método y aceptación\n\nProbabilidad e impacto: 1 raro/insignificante, 2 improbable/menor, 3 posible/moderado, 4 probable/alto, 5 casi cierto/crítico. Riesgo = P×I. 1–4 bajo (aceptable por propietario), 5–9 moderado (tratar o aceptación documentada), 10–15 alto (tratamiento obligatorio), 16–25 crítico (prioridad inmediata). Efectividad 1 inexistente, 2 limitada, 3 parcial, 4 efectiva en laboratorio, 5 validada institucionalmente. Las cifras son estimaciones de escritorio, no mediciones objetivas.\n"""
(OUT / "matriz-riesgos.md").write_text(f"# Análisis de riesgos ISO 27005 / NIST SP 800-30\n\nGenerado: {STAMP}. {DISCLAIMER}\n\n{scale}\n" + table(risk_rows), encoding="utf-8")

cells = defaultdict(list)
for risk in risk_rows:
    cells[(int(risk["impacto_1_5"]), int(risk["probabilidad_1_5"]))].append(risk["id"])
heat = ["# Matriz de calor 5 × 5", "", DISCLAIMER, "", "Cada ID enlaza con `matriz-riesgos.csv`; se representa el riesgo inherente.", "", "| Impacto \\ Probabilidad | 1 | 2 | 3 | 4 | 5 |", "|---|---|---|---|---|---|"]
for impact in range(5, 0, -1):
    heat.append("| " + str(impact) + " | " + " | ".join(", ".join(cells[(impact, probability)]) or "—" for probability in range(1, 6)) + " |")
heat += ["", "Leyenda: 1–4 bajo; 5–9 moderado; 10–15 alto; 16–25 crítico."]
(OUT / "matriz-calor.md").write_text("\n".join(heat), encoding="utf-8")

