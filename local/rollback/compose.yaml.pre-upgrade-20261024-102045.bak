
x-logging: &bounded-logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "5"

services:
  proxy:
    image: local-proxy:latest
    build: ./nginx
    logging: *bounded-logging
    user: "101:101"
    read_only: true
    restart: unless-stopped
    ports:
      - "127.0.0.1:8080:8080"
      - "127.0.0.1:8443:8443"
    volumes:
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
      - tls_runtime:/etc/nginx/tls:ro
    tmpfs:
      - /var/cache/nginx:rw,nosuid,nodev,noexec,size=16m,mode=1777
      - /var/run:rw,nosuid,nodev,noexec,size=1m,mode=1777
      - /tmp:rw,nosuid,nodev,noexec,size=16m,mode=1777
    depends_on:
      api:
        condition: service_healthy
      keycloak:
        condition: service_healthy
      tls-init:
        condition: service_completed_successfully
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://127.0.0.1:8080/healthz"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 5s
    networks: [dmz, apps]
    security_opt: ["no-new-privileges:true"]
    cap_drop: [ALL]

  tls-init:
    image: nginx:stable-alpine
    user: "0:0"
    read_only: true
    restart: "no"
    entrypoint: ["/bin/sh", "-c"]
    command:
      - "cp /source/uvcg-lab.crt /target/uvcg-lab.crt && cp /source/uvcg-lab.key /target/uvcg-lab.key && chown 101:101 /target/uvcg-lab.crt /target/uvcg-lab.key && chmod 640 /target/uvcg-lab.crt /target/uvcg-lab.key"
    volumes:
      - ./tls:/source:ro
      - tls_runtime:/target
    network_mode: none
    security_opt: ["no-new-privileges:true"]
    cap_drop: [ALL]
    cap_add: [CHOWN, FOWNER, DAC_OVERRIDE]

  api:
    build: ./api
    logging: *bounded-logging
    read_only: true
    restart: unless-stopped

    # Directorio temporal para Gunicorn
    tmpfs:
      - /tmp:rw,nosuid,nodev,noexec,size=64m,mode=1777

    environment:
      DB_HOST: db
      DB_PORT: "5432"
      DB_USER: ${DB_USER:?Definir DB_USER}
      DB_PASSWORD: ${DB_PASSWORD:?Definir DB_PASSWORD}
      DB_NAME: ${DB_NAME:?Definir DB_NAME}
      OIDC_ISSUER: https://localhost:8443/auth/realms/uvcg
      OIDC_JWKS_URL: http://keycloak:8080/auth/realms/uvcg/protocol/openid-connect/certs
      OIDC_ALLOWED_CLIENTS: sgsi-cli,sgsi-web
      TMPDIR: /tmp
      GUNICORN_CMD_ARGS: "--worker-tmp-dir /tmp"

    depends_on:
      db:
        condition: service_healthy
      keycloak:
        condition: service_healthy

    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=3)"]
      interval: 10s
      timeout: 5s
      retries: 8
      start_period: 10s

    networks: [apps, datos]
    security_opt: ["no-new-privileges:true"]
    cap_drop: [ALL]
    mem_limit: 256m

  db:
    image: postgres:16-alpine
    logging: *bounded-logging
    read_only: true
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${DB_USER:?Definir DB_USER}
      POSTGRES_PASSWORD: ${DB_PASSWORD:?Definir DB_PASSWORD}
      POSTGRES_DB: ${DB_NAME:?Definir DB_NAME}

    volumes:
      - pgdata:/var/lib/postgresql/data
      - ./init.sql:/docker-entrypoint-initdb.d/init.sql:ro
    tmpfs:
      - /tmp:rw,nosuid,nodev,noexec,size=32m,mode=1777
      - /var/run/postgresql:rw,nosuid,nodev,noexec,size=8m,mode=0775,uid=70,gid=70

    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \"$${POSTGRES_USER}\" -d \"$${POSTGRES_DB}\""]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 10s

    networks: [datos]
    security_opt: ["no-new-privileges:true"]
    cap_drop: [ALL]
    cap_add: [CHOWN, DAC_OVERRIDE, FOWNER, SETGID, SETUID]
    mem_limit: 256m

  identity-db:
    image: postgres:16-alpine
    logging: *bounded-logging
    read_only: true
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${KC_DB_USER:?Definir KC_DB_USER}
      POSTGRES_PASSWORD: ${KC_DB_PASSWORD:?Definir KC_DB_PASSWORD}
      POSTGRES_DB: ${KC_DB_NAME:?Definir KC_DB_NAME}
    volumes:
      - identity_data:/var/lib/postgresql/data
    tmpfs:
      - /tmp:rw,nosuid,nodev,noexec,size=32m,mode=1777
      - /var/run/postgresql:rw,nosuid,nodev,noexec,size=8m,mode=0775,uid=70,gid=70
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \"$${POSTGRES_USER}\" -d \"$${POSTGRES_DB}\""]
      interval: 5s
      timeout: 5s
      retries: 15
      start_period: 10s
    networks: [identity]
    security_opt: ["no-new-privileges:true"]
    cap_drop: [ALL]
    cap_add: [CHOWN, DAC_OVERRIDE, FOWNER, SETGID, SETUID]
    mem_limit: 256m

  keycloak:
    build: ./identity
    logging: *bounded-logging
    read_only: true
    restart: unless-stopped
    command:
      - start
      - --optimized
      - --import-realm
    environment:
      KC_DB: postgres
      KC_DB_URL_HOST: identity-db
      KC_DB_URL_DATABASE: ${KC_DB_NAME:?Definir KC_DB_NAME}
      KC_DB_USERNAME: ${KC_DB_USER:?Definir KC_DB_USER}
      KC_DB_PASSWORD: ${KC_DB_PASSWORD:?Definir KC_DB_PASSWORD}
      KC_BOOTSTRAP_ADMIN_USERNAME: ${KC_ADMIN_USER:?Definir KC_ADMIN_USER}
      KC_BOOTSTRAP_ADMIN_PASSWORD: ${KC_ADMIN_PASSWORD:?Definir KC_ADMIN_PASSWORD}
      KC_HTTP_ENABLED: "true"
      KC_HTTP_RELATIVE_PATH: /auth
      KC_HOSTNAME: https://localhost:8443/auth
      KC_PROXY_HEADERS: xforwarded
      KC_HEALTH_ENABLED: "true"
      KC_METRICS_ENABLED: "true"
      KC_LOG_LEVEL_ORG_KEYCLOAK_EVENTS: debug
      JAVA_OPTS_KC_HEAP: -XX:InitialRAMPercentage=25 -XX:MaxRAMPercentage=65
      UVCG_ADMIN_PASSWORD: ${UVCG_ADMIN_PASSWORD:?Definir UVCG_ADMIN_PASSWORD}
      UVCG_ADMIN_TOTP: ${UVCG_ADMIN_TOTP:?Definir UVCG_ADMIN_TOTP}
      UVCG_DOCENTE_PASSWORD: ${UVCG_DOCENTE_PASSWORD:?Definir UVCG_DOCENTE_PASSWORD}
      UVCG_DOCENTE_TOTP: ${UVCG_DOCENTE_TOTP:?Definir UVCG_DOCENTE_TOTP}
      UVCG_ESTUDIANTE_PASSWORD: ${UVCG_ESTUDIANTE_PASSWORD:?Definir UVCG_ESTUDIANTE_PASSWORD}
      UVCG_ESTUDIANTE_TOTP: ${UVCG_ESTUDIANTE_TOTP:?Definir UVCG_ESTUDIANTE_TOTP}
      UVCG_ADMINISTRATIVO_PASSWORD: ${UVCG_ADMINISTRATIVO_PASSWORD:?Definir UVCG_ADMINISTRATIVO_PASSWORD}
      UVCG_ADMINISTRATIVO_TOTP: ${UVCG_ADMINISTRATIVO_TOTP:?Definir UVCG_ADMINISTRATIVO_TOTP}
    volumes:
      - ./identity/uvcg-realm.json:/opt/keycloak/data/import/uvcg-realm.json:ro
    tmpfs:
      - /tmp:rw,nosuid,nodev,noexec,size=64m,mode=1777
      - /opt/keycloak/data/tmp:rw,nosuid,nodev,noexec,size=64m,mode=1777
    depends_on:
      identity-db:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "{ printf 'GET /auth/health/ready HTTP/1.0\\r\\n\\r\\n' >&0; grep 'HTTP/1.0 200'; } 0<>/dev/tcp/127.0.0.1/9000"]
      interval: 10s
      timeout: 5s
      retries: 18
      start_period: 30s
    networks: [apps, identity]
    security_opt: ["no-new-privileges:true"]
    cap_drop: [ALL]
    mem_limit: 1g

  backup-tool:
    build: ./backup
    image: local-backup-tool:latest
    profiles: [backup, recovery]
    user: "70:70"
    read_only: true
    environment:
      PGHOST: db
      PGUSER: ${DB_USER:?Definir DB_USER}
      PGPASSWORD: ${DB_PASSWORD:?Definir DB_PASSWORD}
      PGDATABASE: ${DB_NAME:?Definir DB_NAME}
      BACKUP_PREFIX: academic
      BACKUP_ENCRYPTION_PASSWORD: ${BACKUP_ENCRYPTION_PASSWORD:?Definir BACKUP_ENCRYPTION_PASSWORD}
    volumes:
      - ./backups:/backups
    tmpfs:
      - /tmp:rw,nosuid,nodev,noexec,size=32m,mode=1777
    networks: [datos, recovery]
    security_opt: ["no-new-privileges:true"]
    cap_drop: [ALL]
    mem_limit: 128m

  identity-backup-tool:
    build: ./backup
    image: local-backup-tool:latest
    profiles: [backup, recovery]
    read_only: true
    environment:
      PGHOST: identity-db
      PGUSER: ${KC_DB_USER:?Definir KC_DB_USER}
      PGPASSWORD: ${KC_DB_PASSWORD:?Definir KC_DB_PASSWORD}
      PGDATABASE: ${KC_DB_NAME:?Definir KC_DB_NAME}
      BACKUP_PREFIX: identity
      BACKUP_ENCRYPTION_PASSWORD: ${BACKUP_ENCRYPTION_PASSWORD:?Definir BACKUP_ENCRYPTION_PASSWORD}
    volumes:
      - ./backups:/backups
    tmpfs:
      - /tmp:rw,nosuid,nodev,noexec,size=64m,mode=1777
    networks: [identity, recovery]
    security_opt: ["no-new-privileges:true"]
    cap_drop: [ALL]
    mem_limit: 128m

  academic-backup-scheduler:
    build: ./backup
    image: local-backup-tool:latest
    logging: *bounded-logging
    profiles: [backup-scheduled]
    restart: unless-stopped
    command: ["/usr/local/bin/backup-encrypted.sh"]
    read_only: true
    environment:
      PGHOST: db
      PGUSER: ${DB_USER:?Definir DB_USER}
      PGPASSWORD: ${DB_PASSWORD:?Definir DB_PASSWORD}
      PGDATABASE: ${DB_NAME:?Definir DB_NAME}
      BACKUP_PREFIX: academic
      BACKUP_ENCRYPTION_PASSWORD: ${BACKUP_ENCRYPTION_PASSWORD:?Definir BACKUP_ENCRYPTION_PASSWORD}
      BACKUP_INTERVAL_SECONDS: ${BACKUP_INTERVAL_SECONDS:-86400}
    volumes:
      - ./backups:/backups
    tmpfs:
      - /tmp:rw,nosuid,nodev,noexec,size=64m,mode=1777
    networks: [datos]
    depends_on:
      db:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "kill -0 1"]
      interval: 60s
      timeout: 5s
      retries: 3
    security_opt: ["no-new-privileges:true"]
    cap_drop: [ALL]
    mem_limit: 128m

  identity-backup-scheduler:
    build: ./backup
    image: local-backup-tool:latest
    logging: *bounded-logging
    profiles: [backup-scheduled]
    restart: unless-stopped
    command: ["/usr/local/bin/backup-encrypted.sh"]
    read_only: true
    environment:
      PGHOST: identity-db
      PGUSER: ${KC_DB_USER:?Definir KC_DB_USER}
      PGPASSWORD: ${KC_DB_PASSWORD:?Definir KC_DB_PASSWORD}
      PGDATABASE: ${KC_DB_NAME:?Definir KC_DB_NAME}
      BACKUP_PREFIX: identity
      BACKUP_ENCRYPTION_PASSWORD: ${BACKUP_ENCRYPTION_PASSWORD:?Definir BACKUP_ENCRYPTION_PASSWORD}
      BACKUP_INTERVAL_SECONDS: ${BACKUP_INTERVAL_SECONDS:-86400}
    volumes:
      - ./backups:/backups
    tmpfs:
      - /tmp:rw,nosuid,nodev,noexec,size=64m,mode=1777
    networks: [identity]
    depends_on:
      identity-db:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "kill -0 1"]
      interval: 60s
      timeout: 5s
      retries: 3
    security_opt: ["no-new-privileges:true"]
    cap_drop: [ALL]
    mem_limit: 128m

  restore-db:
    image: local-postgres-hardened:16
    build: ./postgres-hardened
    user: "70:70"
    profiles: [recovery]
    read_only: true
    restart: "no"
    environment:
      POSTGRES_USER: ${DB_USER:?Definir DB_USER}
      POSTGRES_PASSWORD: ${DB_PASSWORD:?Definir DB_PASSWORD}
      POSTGRES_DB: restore_admin
    volumes:
      - restore_test_data:/var/lib/postgresql/data
    tmpfs:
      - /tmp:rw,nosuid,nodev,noexec,size=32m,mode=1777
      - /var/run/postgresql:rw,nosuid,nodev,noexec,size=8m,mode=0775,uid=70,gid=70
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \"$${POSTGRES_USER}\" -d restore_admin"]
      interval: 3s
      timeout: 5s
      retries: 20
      start_period: 10s
    networks: [recovery]
    security_opt: ["no-new-privileges:true"]
    cap_drop: [ALL]
    mem_limit: 256m

  identity-restore-db:
    image: local-postgres-hardened:16
    build: ./postgres-hardened
    user: "70:70"
    profiles: [recovery]
    read_only: true
    restart: "no"
    environment:
      POSTGRES_USER: ${KC_DB_USER:?Definir KC_DB_USER}
      POSTGRES_PASSWORD: ${KC_DB_PASSWORD:?Definir KC_DB_PASSWORD}
      POSTGRES_DB: restore_identity_admin
    volumes:
      - identity_restore_test_data:/var/lib/postgresql/data
    tmpfs:
      - /tmp:rw,nosuid,nodev,noexec,size=32m,mode=1777
      - /var/run/postgresql:rw,nosuid,nodev,noexec,size=8m,mode=0775,uid=70,gid=70
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \"$${POSTGRES_USER}\" -d restore_identity_admin"]
      interval: 3s
      timeout: 5s
      retries: 20
      start_period: 10s
    networks: [recovery]
    security_opt: ["no-new-privileges:true"]
    cap_drop: [ALL]
    mem_limit: 256m

  ids:
    image: jasonish/suricata:7.0
    profiles: [ids]
    user: "998:998"
    read_only: true
    command:
      - -r
      - /pcap/trafico-controlado.pcap
      - -S
      - /rules/uvcg.rules
      - -l
      - /output
    volumes:
      - ./ids/pcap:/pcap:ro
      - ./ids/rules:/rules:ro
      - ../evidencias/ids:/output
    tmpfs:
      - /tmp:rw,nosuid,nodev,noexec,size=64m,mode=1777
      - /var/run/suricata:rw,nosuid,nodev,noexec,size=8m,mode=1777
    network_mode: none
    security_opt: ["no-new-privileges:true"]
    cap_drop: [ALL]
    mem_limit: 512m

  security-python:
    build: ../security-tools
    profiles: [security]
    user: "10001:10001"
    read_only: true
    volumes:
      - ..:/workspace:ro
      - ../evidencias/security:/reports
    tmpfs:
      - /tmp:rw,nosuid,nodev,exec,size=128m,mode=1777
      - /home/scanner/.cache:rw,nosuid,nodev,noexec,size=64m,mode=0700,uid=10001,gid=10001
    network_mode: bridge
    security_opt: ["no-new-privileges:true"]
    cap_drop: [ALL]
    mem_limit: 256m

  trivy:
    image: aquasec/trivy:0.76.1
    profiles: [security]
    read_only: true
    volumes:
      - ..:/workspace:ro
      - ../evidencias/security:/reports
      - trivy_cache:/root/.cache
      - trivy_tmp:/tmp
    network_mode: bridge
    security_opt: ["no-new-privileges:true"]
    cap_drop: [ALL]
    mem_limit: 3g

volumes:
  pgdata:
  identity_data:
  tls_runtime:
  restore_test_data:
  identity_restore_test_data:
  trivy_cache:
  trivy_tmp:

networks:
  dmz: {}
  apps:
    internal: true
  datos:
    internal: true
  identity:
    internal: true
  recovery:
    internal: true
