# Reglas IDS de laboratorio UVCG (Suricata 7). Documentación: evidencias/ids/reglas-ids.md
# Rango SID local reservado: 1000001-1000099. Sólo se evalúan contra PCAP sintético autorizado.
alert http any any -> any any (msg:"UVCG LAB intento de path traversal controlado"; flow:established,to_server; http.uri.raw; content:"../"; sid:1000001; rev:2; classtype:web-application-attack;)
alert tcp any any -> any 5432 (msg:"UVCG LAB intento directo a PostgreSQL"; flags:S; sid:1000002; rev:1; classtype:attempted-recon;)
alert http any any -> any any (msg:"UVCG LAB posible inyeccion SQL UNION SELECT en URI"; flow:established,to_server; http.uri; content:"union"; nocase; content:"select"; nocase; distance:0; sid:1000003; rev:1; classtype:web-application-attack;)
alert http any any -> any any (msg:"UVCG LAB agente de escaneo automatizado conocido"; flow:established,to_server; http.user_agent; pcre:"/(sqlmap|nikto|nmap)/i"; sid:1000004; rev:1; classtype:web-application-attack;)
alert http any any -> any any (msg:"UVCG LAB acceso a consola administrativa Keycloak"; flow:established,to_server; http.uri; content:"/auth/admin/"; startswith; sid:1000005; rev:1; classtype:policy-violation;)
alert tcp any any -> any 9000 (msg:"UVCG LAB conexion al puerto de gestion Keycloak"; flags:S; sid:1000006; rev:1; classtype:attempted-recon;)
alert http any any -> any any (msg:"UVCG LAB rafaga de intentos de login Keycloak"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/login-actions/authenticate"; detection_filter:track by_src, count 5, seconds 60; sid:1000007; rev:1; classtype:attempted-user;)
